{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "node_modules/**/*",
    ".github/**/*",
    "app/src-tauri/**/*",
    "app/build/**/*",
    "app/.svelte-kit/**/*"
  ],
  "printWidth": 80,
  "singleQuote": true,
  "trailingComma": "none",
  "svelte": true,
  "sortTailwindcss": true
}
